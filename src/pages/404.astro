---
import Background from "../components/Background.astro";
import Spotlight from "../components/Spotlight.astro";
import Layout from "../layouts/Layout.astro";
---

<!-- Not found: one page for both languages (there's no way to know which one the visitor wanted) -->
<Layout lang="en" noindex>
   <Background />
   <Spotlight />
   <main class="relative mx-auto flex min-h-screen max-w-screen-sm flex-col justify-center px-6 py-16 font-sans text-zinc-400 md:px-12">
      <p class="not-found font-[Oxanium] text-[7rem] leading-none font-bold tracking-tight text-zinc-100 sm:text-[9rem]" data-text="404">404</p>

      <h1 class="mt-6 text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">Lost in space.</h1>
      <p class="mt-3 leading-relaxed">This page drifted off the map, or never existed.</p>
      <p class="mt-1 leading-relaxed text-zinc-500" lang="pt">Esta página saiu do mapa, ou nunca existiu.</p>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
         <a class="back-link group inline-flex items-center gap-2 font-semibold text-zinc-100" href="/" data-reveal>
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 transition-transform group-hover:-translate-x-1 motion-reduce:transition-none" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"></path></svg>
            Back home
         </a>
         <a class="back-link group inline-flex items-center gap-2 font-semibold text-zinc-300" href="/pt/" lang="pt" data-reveal>
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 transition-transform group-hover:-translate-x-1 motion-reduce:transition-none" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"></path></svg>
            Voltar ao início
         </a>
      </div>
   </main>
</Layout>

<style>
/* "404" with the site's RGB-split glitch: cyan/red ghosts, and every few seconds a slice tears sideways */
.not-found {
   position: relative;
   width: fit-content;
   text-shadow: -3px 0 var(--glitch-blue), 3px 0 var(--glitch-red);
}

.not-found::before,
.not-found::after {
   content: attr(data-text);
   content: attr(data-text) / "";
   position: absolute;
   inset: 0;
   clip-path: inset(0 0 100% 0);
   pointer-events: none;
}

.not-found::before {
   animation: tear-a 3.2s steps(1, end) infinite;
}

.not-found::after {
   animation: tear-b 3.2s steps(1, end) infinite;
}

@keyframes tear-a {
   0%, 86%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
   88% { clip-path: inset(18% 0 62% 0); transform: translateX(-10px); }
   91% { clip-path: inset(55% 0 30% 0); transform: translateX(8px); }
   94% { clip-path: inset(30% 0 55% 0); transform: translateX(-5px); }
}

@keyframes tear-b {
   0%, 86%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
   88% { clip-path: inset(68% 0 12% 0); transform: translateX(9px); }
   91% { clip-path: inset(8% 0 78% 0); transform: translateX(-7px); }
   94% { clip-path: inset(80% 0 4% 0); transform: translateX(4px); }
}

.back-link:hover {
   color: var(--color-white);
}

@media (prefers-reduced-motion: reduce) {
   .not-found::before,
   .not-found::after {
      animation: none;
   }
}
</style>
