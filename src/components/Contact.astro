---
import SectionHeading from "./SectionHeading.astro";

const fieldClass =
   "mt-2 block w-full rounded-md border border-zinc-800 bg-zinc-900/60 px-3.5 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 transition focus:border-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-500/20";
const labelClass = "text-xs font-semibold uppercase tracking-wide text-zinc-500";
---

<section id="contact" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24" aria-label="Contact">
   <SectionHeading number="04" title="Contact" />

   <p class="mb-8">
      Have a project in mind, a role to fill, or just want to talk tech? Send me a message and I’ll get back to you.
   </p>

   <form class="space-y-5" data-contact-form novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
         <label class="block">
            <span class={labelClass}>Name</span>
            <input class={fieldClass} type="text" name="name" autocomplete="name" placeholder="Your name" required />
         </label>
         <label class="block">
            <span class={labelClass}>Email</span>
            <input class={fieldClass} type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
         </label>
      </div>

      <label class="block">
         <span class={labelClass}>Message</span>
         <textarea class={`${fieldClass} min-h-36 resize-y`} name="message" rows="5" placeholder="Tell me about your project…" required></textarea>
      </label>

      <!-- Honeypot: hidden from people, bots tend to fill it in -->
      <div class="hidden" aria-hidden="true">
         <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="flex flex-wrap items-center gap-4">
         <button
            type="submit"
            class="group/send inline-flex items-center gap-2 rounded-md bg-zinc-100 px-5 py-2.5 text-sm font-semibold text-zinc-900 transition hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 disabled:cursor-not-allowed disabled:opacity-60"
            data-contact-submit
         >
            <span data-contact-label>Send message</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform group-hover/send:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
               <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"></path>
            </svg>
         </button>
         <p class="text-sm" role="status" aria-live="polite" data-contact-status></p>
      </div>
   </form>
</section>

<script>
   import emailjs from "@emailjs/browser";

   // Set these in .env (see .env.example); PUBLIC_ variables are available in the browser
   const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
   const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;
   const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;

   const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

   if (form) {
      const button = form.querySelector<HTMLButtonElement>("[data-contact-submit]")!;
      const label = form.querySelector<HTMLElement>("[data-contact-label]")!;
      const status = form.querySelector<HTMLElement>("[data-contact-status]")!;

      const setStatus = (message: string, tone: "muted" | "success" | "error") => {
         status.textContent = message;
         status.className = `text-sm ${tone === "success" ? "text-zinc-100" : tone === "error" ? "text-red-400" : "text-zinc-500"}`;
      };

      form.addEventListener("submit", async (event) => {
         event.preventDefault();

         // Bots that fill the hidden field get a fake success
         if ((form.elements.namedItem("company") as HTMLInputElement).value) {
            form.reset();
            setStatus("Thanks! Your message has been sent.", "success");
            return;
         }

         if (!form.checkValidity()) {
            form.reportValidity();
            return;
         }

         if (!SERVICE_ID || !TEMPLATE_ID || !PUBLIC_KEY) {
            console.error("EmailJS is not configured: set the PUBLIC_EMAILJS_* variables in .env");
            setStatus("The form isn’t set up yet. Please try again later.", "error");
            return;
         }

         button.disabled = true;
         label.textContent = "Sending…";
         setStatus("", "muted");

         try {
            await emailjs.sendForm(SERVICE_ID, TEMPLATE_ID, form, { publicKey: PUBLIC_KEY });
            form.reset();
            setStatus("Thanks! Your message has been sent. I’ll get back to you soon.", "success");
         } catch (error) {
            console.error("EmailJS error", error);
            setStatus("Something went wrong. Please try again in a moment.", "error");
         } finally {
            button.disabled = false;
            label.textContent = "Send message";
         }
      });
   }
</script>
