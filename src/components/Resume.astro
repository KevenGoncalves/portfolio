---
import "../styles/global.css";
import { experience, formatPeriod, jobSpan, type EmploymentType, type Job } from "../data/experience";
import { achievements, bullets, contacts, education, headline, languages, location, skills } from "../data/resume";
import { langPath, localize, useTranslations, type Lang } from "../i18n/ui";
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
   lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const resumePath: Record<Lang, string> = { en: "/resume/", pt: "/pt/resume/" };
const pdfPath = `/resume-${lang}.pdf`;

/** "Full-time · Beira, Mozambique · On-site" */
const metaLine = (job: Job, type?: EmploymentType) =>
   [
      type && t(`experience.${type}`),
      job.location && `${job.location.city}, ${t("experience.country")}`,
      job.location?.workplace && t(`experience.${job.location.workplace}`),
   ]
      .filter(Boolean)
      .join(" · ");
---

<!doctype html>
<html lang={lang} data-theme="dark">
   <head>
      <meta charset="UTF-8" />
      <!-- Same saved theme as the site, applied before paint (the CV sheet itself always stays white) -->
      <script is:inline>
         try {
            if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
         } catch {}
      </script>
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Oxanium:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
      <title>Keven Gonçalves — {t("resume.title")}</title>
   </head>
   <body class="resume-body font-sans text-zinc-700 antialiased">
      <!-- Screen-only toolbar: back to the site, the site's theme and language toggles, PDF download -->
      <nav class="toolbar mx-auto flex max-w-[210mm] flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm print:hidden">
         <a href={langPath[lang]} class="inline-flex items-center gap-1.5 font-medium text-zinc-400 transition hover:text-zinc-100">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"></path></svg>
            {t("resume.back")}
         </a>
         <div class="flex items-center gap-2">
            <ThemeToggle lang={lang} />
            <LanguageToggle lang={lang} paths={resumePath} />
            <a href={pdfPath} download={`Keven-Goncalves-CV-${lang.toUpperCase()}.pdf`} class="inline-flex h-9 items-center gap-2 rounded-full bg-zinc-100 px-4 text-xs font-semibold text-zinc-900 transition hover:bg-white">
               <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z"></path><path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"></path></svg>
               {t("resume.download")}
            </a>
         </div>
      </nav>

      <!-- A4 sheet -->
      <article class="sheet">
         <header class="grid grid-cols-[1fr_auto] items-start gap-10">
            <div>
               <h1 class="font-[Oxanium] text-[34px] leading-none font-bold tracking-tight text-zinc-900">Keven Gonçalves</h1>
               <p class="mt-2 text-[13px] font-semibold text-red-600">{t("header.role")}</p>
               <p class="mt-2 max-w-[118mm] text-[10.5px] leading-[1.6] text-zinc-600">{localize(headline, lang)}</p>
            </div>
            <ul class="space-y-1 pt-1 text-right text-[10.5px] text-zinc-700">
               <li>{localize(location, lang)}</li>
               {contacts.map((contact) => (
                  <li><a href={contact.href} class="hover:text-red-600">{contact.label}</a></li>
               ))}
            </ul>
         </header>

         <div class="mt-6 grid grid-cols-[1fr_60mm] gap-9">
            <!-- Experience -->
            <section>
               <h2 class="resume-heading">{t("resume.experience")}</h2>
               {experience.map((job) => {
                  const single = job.roles.length === 1;
                  const [latest] = job.roles;
                  const span = jobSpan(job);
                  const meta = metaLine(job, single ? latest.type : undefined);
                  return (
                     <div class="mb-3 break-inside-avoid">
                        {single ? (
                           <p class="text-[11.5px] text-zinc-900">
                              <span class="font-semibold">{localize(latest.title, lang)}</span> · <span class="font-semibold">{job.company}</span>
                              <span class="ml-1.5 whitespace-nowrap text-[10px] text-zinc-400">{formatPeriod(span.start, span.end, lang)}</span>
                           </p>
                        ) : (
                           <>
                              <p class="text-[11.5px] font-semibold text-zinc-900">{job.company}</p>
                              {job.roles.map((role) => (
                                 <p class="text-[11px] text-zinc-800">
                                    {localize(role.title, lang)}
                                    {role.type && <span class="text-zinc-500"> · {t(`experience.${role.type}`)}</span>}
                                    <span class="ml-1.5 whitespace-nowrap text-[10px] text-zinc-400">{formatPeriod(role.start, role.end, lang)}</span>
                                 </p>
                              ))}
                           </>
                        )}
                        {meta && <p class="text-[10px] text-zinc-500">{meta}</p>}
                        {bullets[job.company] && (
                           <ul class="mt-1.5 list-disc space-y-0.5 pl-4 text-[10.5px] leading-[1.55] text-zinc-700 marker:text-zinc-400">
                              {bullets[job.company].map((bullet) => <li>{localize(bullet, lang)}</li>)}
                           </ul>
                        )}
                     </div>
                  );
               })}
            </section>

            <!-- Sidebar -->
            <aside class="space-y-7">
               <section>
                  <h2 class="resume-heading">{t("resume.skills")}</h2>
                  {skills.map((skill) => (
                     <div class="mb-3">
                        <h3 class="text-[11px] font-semibold text-zinc-900">{localize(skill.group, lang)}</h3>
                        <p class="text-[10.5px] leading-[1.55] text-zinc-600">{skill.items}</p>
                     </div>
                  ))}
               </section>

               <section>
                  <h2 class="resume-heading">{t("resume.education")}</h2>
                  {education.map((item) => (
                     <div>
                        <h3 class="text-[11px] font-semibold text-zinc-900">{item.school}</h3>
                        <p class="text-[10.5px] leading-[1.55] text-zinc-600">{localize(item.degree, lang)}</p>
                        <p class="text-[10px] text-zinc-400">{item.years}</p>
                     </div>
                  ))}
               </section>

               <section>
                  <h2 class="resume-heading">{t("resume.languages")}</h2>
                  {languages.map((item) => (
                     <p class="mb-1 text-[10.5px] text-zinc-600">
                        <span class="font-semibold text-zinc-900">{localize(item.name, lang)}</span> — {localize(item.level, lang)}
                     </p>
                  ))}
               </section>

               <section>
                  <h2 class="resume-heading">{t("resume.achievements")}</h2>
                  {achievements.map((item) => (
                     <div class="mb-2.5">
                        <p class="text-[10px] font-semibold text-red-600">{item.year}</p>
                        <p class="text-[10.5px] leading-[1.55] text-zinc-600">{localize(item.text, lang)}</p>
                     </div>
                  ))}
               </section>
            </aside>
         </div>
      </article>
   </body>
</html>

<style>
/* Paper look on screen, exact A4 when printed / exported to PDF.
   The backdrop follows the site theme; the sheet always stays white paper. */
:global(html) {
   background: #18181b;
}

:global(html[data-theme="light"]) {
   background: #e4e4e7;
}

.resume-body {
   min-height: 100vh;
   padding-bottom: 3rem;
}

.sheet {
   /* Pin the zinc greys to their real values here, so the light theme's flipped palette never reaches the paper */
   --color-zinc-50: oklch(98.5% 0 0);
   --color-zinc-100: oklch(96.7% 0.001 286.375);
   --color-zinc-200: oklch(92% 0.004 286.32);
   --color-zinc-300: oklch(87.1% 0.006 286.286);
   --color-zinc-400: oklch(70.5% 0.015 286.067);
   --color-zinc-500: oklch(55.2% 0.016 285.938);
   --color-zinc-600: oklch(44.2% 0.017 285.786);
   --color-zinc-700: oklch(37% 0.013 285.805);
   --color-zinc-800: oklch(27.4% 0.006 286.033);
   --color-zinc-900: oklch(21% 0.006 285.885);
   --color-zinc-950: oklch(14.1% 0.005 285.823);
   --color-red-400: oklch(70.4% 0.191 22.216);
   width: 210mm;
   min-height: 297mm;
   margin: 0 auto;
   padding: 13mm 15mm 10mm;
   background: #fff;
   box-shadow: 0 10px 40px rgb(0 0 0 / 0.25);
}

.resume-heading {
   display: flex;
   align-items: center;
   gap: 0.5rem;
   margin-bottom: 0.85rem;
   font-size: 12px;
   font-weight: 700;
   letter-spacing: 0.14em;
   text-transform: uppercase;
   color: #18181b;
}

.resume-heading::before {
   content: "";
   width: 4px;
   height: 12px;
   border-radius: 2px;
   background: #ef4444;
}

/* Small screens: let the sheet scale down instead of overflowing sideways */
@media screen and (max-width: 820px) {
   .sheet {
      zoom: calc(100vw / 820px);
   }
}

@page {
   size: A4;
   margin: 0;
}

@media print {
   :global(html),
   :global(html[data-theme="light"]) {
      background: #fff;
   }

   .resume-body {
      padding: 0;
   }

   .sheet {
      box-shadow: none;
      zoom: 1;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
   }
}
</style>
