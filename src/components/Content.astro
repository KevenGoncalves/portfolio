---
import type { Lang } from "../i18n/ui";
import Header from "./Header.astro";
import About from "./About.astro";
import Experience from "./Experience.astro";
import Project from "./Project.astro";
import Contact from "./Contact.astro";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="relative mx-auto min-h-screen max-w-screen-xl px-6 py-12 font-sans md:px-12 md:py-16 lg:py-0 text-zinc-400">
  <div class="absolute top-6 right-6 z-30 md:right-12 lg:top-8">
    <LanguageToggle lang={lang} />
  </div>
  <div class="lg:flex lg:justify-between lg:gap-4">
    <Header lang={lang} />
     <main id="content" class="pt-24 lg:w-[52%] lg:py-24">
      <About lang={lang} />
      <Experience lang={lang} />
      <Project lang={lang} />
      <Contact lang={lang} />
     </main>
  </div>
</div>
