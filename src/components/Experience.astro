---
import { experience } from "../data/experience";
---

<section id="experience" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24" aria-label="Work experience">
   <div class="sticky top-0 z-20 -mx-6 mb-4 bg-zinc-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-100 lg:sr-only">Experience</h2>
   </div>
   <div>
      <div class="timeline relative lg:-mt-16" data-timeline>
         <span class="timeline-track" aria-hidden="true"></span>
         <span class="timeline-progress" aria-hidden="true"></span>
         <span class="timeline-pad" aria-hidden="true">
            <svg viewBox="0 0 36 26" fill="none">
               <rect x="2.5" y="4.5" width="31" height="3" rx="1.5" fill="white" fill-opacity="0.25" stroke="white" stroke-opacity="0.7" />
               <path class="pad-clamp" d="M9.5 8v13.5l1.5 1.5" stroke="white" stroke-opacity="0.7" stroke-linecap="round" stroke-linejoin="round" />
               <path class="pad-clamp" d="M26.5 8v13.5l-1.5 1.5" stroke="white" stroke-opacity="0.7" stroke-linecap="round" stroke-linejoin="round" />
               <circle class="pad-beacon" cx="18" cy="2" r="1.6" fill="#ef4444" />
            </svg>
         </span>
         <p class="timeline-hint" aria-hidden="true">
            Scroll to launch
            <svg viewBox="0 0 20 20" fill="currentColor" class="hint-arrow">
               <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
            </svg>
         </p>
         <span class="timeline-rocket" aria-hidden="true">
            <svg viewBox="0 0 24 80" fill="none">
               <!-- Flame (flat layers): red outer, orange middle, pale yellow core -->
               <g class="rocket-thrust">
                  <g class="rocket-flame">
                     <path d="M8.5 62c1 8 2.5 14.5 3.5 17 1-2.5 2.5-9 3.5-17Z" fill="#ef4444" fill-opacity="0.6" />
                     <path d="M9.8 62c.7 5.5 1.6 9.5 2.2 11 .6-1.5 1.5-5.5 2.2-11Z" fill="#fb923c" />
                     <path d="M11 62c.3 3 .7 5 1 6 .3-1 .7-3 1-6Z" fill="#fef3c7" />
                  </g>
               </g>
               <!-- Fins -->
               <path d="M5 42c-2.5 2-4 5.5-4 10v6l4-3Z" fill="#09090b" />
               <path d="M5 42c-2.5 2-4 5.5-4 10v6l4-3Z" fill="white" fill-opacity="0.25" stroke="white" stroke-opacity="0.7" stroke-linejoin="round" />
               <path d="M19 42c2.5 2 4 5.5 4 10v6l-4-3Z" fill="#09090b" />
               <path d="M19 42c2.5 2 4 5.5 4 10v6l-4-3Z" fill="white" fill-opacity="0.25" stroke="white" stroke-opacity="0.7" stroke-linejoin="round" />
               <!-- Engine nozzle -->
               <path d="M9 58h6l1 3.5a.5.5 0 0 1-.5.5h-7a.5.5 0 0 1-.5-.5Z" fill="white" />
               <!-- Glass body: dark base so the rail doesn't show through, translucent white, thin outline -->
               <path d="M12 .75C15.2 3.2 19 9.5 19 18v36c0 2.2-1.8 4-4 4H9c-2.2 0-4-1.8-4-4V18C5 9.5 8.8 3.2 12 .75Z" fill="#09090b" />
               <path d="M12 .75C15.2 3.2 19 9.5 19 18v36c0 2.2-1.8 4-4 4H9c-2.2 0-4-1.8-4-4V18C5 9.5 8.8 3.2 12 .75Z" fill="white" fill-opacity="0.25" stroke="white" stroke-opacity="0.7" />
               <!-- Nose: solid cap inset from the outline, with a curved seam below it -->
               <path d="M12 2.7c2.2 1.8 4.2 4.8 5.1 8.4-1.6.8-8.6.8-10.2 0 .9-3.6 2.9-6.6 5.1-8.4Z" fill="white" />
               <path d="M5.9 14.3c1.9-.8 10.3-.8 12.2 0" stroke="white" stroke-opacity="0.7" stroke-width="0.75" stroke-linecap="round" />
               <!-- Side lines -->
               <path d="M8.5 16.5v37.5M15.5 16.5v37.5" stroke="white" stroke-opacity="0.35" stroke-width="0.75" stroke-linecap="round" />
               <!-- Segment lines -->
               <path d="M5 26.5c0-1.4 2.3-2 7-2s7 .6 7 2M5 40.5c0-1.4 2.3-2 7-2s7 .6 7 2" stroke="white" stroke-width="0.75" />
               <!-- Windows -->
               <ellipse cx="12" cy="20" rx="2" ry="1.5" stroke="white" stroke-width="0.9" />
               <ellipse cx="12" cy="33" rx="2" ry="1.5" stroke="white" stroke-width="0.9" />
               <ellipse cx="12" cy="47.5" rx="2" ry="1.5" stroke="white" stroke-width="0.9" />
            </svg>
         </span>
         <ol class="timeline-list group/list">

         {experience.map((job) => (
            <li class="timeline-item relative mb-12 pl-9 last:mb-0 sm:pl-11" data-timeline-item>
               <span class:list={["timeline-dot", { "is-current": job.current }]} data-timeline-dot aria-hidden="true"></span>
               <div class="group relative pb-1 transition-all lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
                  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-zinc-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(212,212,216,0.1)] lg:group-hover:drop-shadow-lg"></div>
                  <div class="relative z-10">
                     <p class="timeline-period text-xs font-semibold uppercase tracking-wide text-zinc-500" aria-label={job.periodLabel}>{job.period}</p>
                     <h3 class="mt-2 font-medium leading-snug text-zinc-100">
                        <a class="group/link inline-flex items-baseline text-base font-medium leading-tight text-zinc-100 hover:text-white focus-visible:text-white" href={job.url} target="_blank" rel="noreferrer noopener" aria-label={`${job.title} at ${job.company} (opens in a new tab)`}>
                           <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"></span>
                           <span>
                              {job.title} ·{" "}
                              <span class="inline-block">
                                 {job.company}
                                 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
                                 </svg>
                              </span>
                           </span>
                        </a>
                     </h3>

                     {job.previousTitles && (
                        <ul class="relative mt-2 space-y-1 pl-4 before:absolute before:top-2 before:bottom-2 before:left-[3px] before:w-px before:bg-zinc-700" aria-label="Previous roles">
                           {job.previousTitles.map((title) => (
                              <li class="relative text-sm text-zinc-500">
                                 <span class="absolute top-1/2 -left-4 size-[7px] -translate-y-1/2 rounded-full border border-zinc-600 bg-zinc-950" aria-hidden="true"></span>
                                 {title}
                              </li>
                           ))}
                        </ul>
                     )}

                     <p class="mt-2 text-sm leading-normal">{job.description}</p>

                     {job.links && (
                        <ul class="mt-2 flex flex-wrap" aria-label="Related links">
                           {job.links.map((link) => (
                              <li class="mr-4">
                                 <a class="relative mt-2 inline-flex items-center text-sm font-medium text-zinc-300 hover:text-white focus-visible:text-white" href={link.url} target="_blank" rel="noreferrer noopener" aria-label={`${link.label} (opens in a new tab)`}>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mr-1 h-3 w-3" aria-hidden="true">
                                       <path d="M12.232 4.232a2.5 2.5 0 013.536 3.536l-1.225 1.224a.75.75 0 001.061 1.06l1.224-1.224a4 4 0 00-5.656-5.656l-3 3a4 4 0 00.225 5.865.75.75 0 00.977-1.138 2.5 2.5 0 01-.142-3.667l3-3z"></path>
                                       <path d="M11.603 7.963a.75.75 0 00-.977 1.138 2.5 2.5 0 01.142 3.667l-3 3a2.5 2.5 0 01-3.536-3.536l1.225-1.224a.75.75 0 00-1.061-1.06l-1.224 1.224a4 4 0 105.656 5.656l3-3a4 4 0 00-.225-5.865z"></path>
                                    </svg>
                                    <span>{link.label}</span>
                                 </a>
                              </li>
                           ))}
                        </ul>
                     )}

                     <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                        {job.tech.map((tech) => (
                           <li class="mr-1.5 mt-2">
                              <div class="flex items-center rounded-full bg-zinc-400/10 px-3 py-1 text-xs font-medium leading-5 text-zinc-300">{tech}</div>
                           </li>
                        ))}
                     </ul>
                  </div>
               </div>
            </li>
         ))}
         </ol>
      </div>

      <div class="mt-12">
         <a class="group/link inline-flex items-baseline text-base font-semibold leading-tight text-zinc-100 hover:text-white focus-visible:text-white" href="/resume.pdf" target="_blank" rel="noreferrer noopener" aria-label="View Full Résumé (opens in a new tab)">
            <span>
               View Full{" "}
               <span class="inline-block">
                  Résumé
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
                     <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
                  </svg>
               </span>
            </span>
         </a>
      </div>
   </div>
</section>

<style>
/* --start is where the rail begins: just below the launch pad, at the docked rocket's nose */
.timeline {
  --start: 70px;
}

/* Launch pad at the top of the rail, with a blinking beacon */
.timeline-pad {
  position: absolute;
  top: 0;
  left: 7.5px;
  width: 36px;
  translate: -50% 0;
  pointer-events: none;
}

.timeline-pad svg {
  display: block;
  width: 100%;
  height: auto;
}

.pad-beacon {
  animation: pad-blink 1.6s ease-in-out infinite;
}

.pad-clamp {
  transform-box: fill-box;
  transition: transform 0.35s ease;
}

.pad-clamp:first-of-type {
  transform-origin: top right;
}

.pad-clamp:last-of-type {
  transform-origin: top left;
}

.timeline:not(.is-docked) .pad-clamp:first-of-type {
  transform: rotate(25deg);
}

.timeline:not(.is-docked) .pad-clamp:last-of-type {
  transform: rotate(-25deg);
}

/* "Scroll to launch" hint, only while the rocket is docked */
.timeline-hint {
  position: absolute;
  top: 24px;
  left: 2.25rem;
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #71717a; /* zinc-500 */
  opacity: 0;
  translate: 0 -4px;
  transition: opacity 0.4s ease, translate 0.4s ease;
  pointer-events: none;
}

.is-docked .timeline-hint {
  opacity: 1;
  translate: 0 0;
}

.hint-arrow {
  width: 0.875rem;
  height: 0.875rem;
  animation: hint-bob 1.4s ease-in-out infinite;
}

.timeline-list {
  padding-top: calc(var(--start) + 1.25rem);
}

@media (min-width: 40rem) {
  .timeline-hint {
    left: 2.75rem;
  }
}

/* Rail: a faint track, plus a bright line that fills as you scroll */
.timeline-track,
.timeline-progress {
  position: absolute;
  left: 7px;
  width: 1px;
  pointer-events: none;
}

.timeline-track {
  top: 7px;
  bottom: 0;
  background: linear-gradient(to bottom, #3f3f46 0%, #27272a 12%, #27272a 85%, transparent 100%); /* zinc-700 → zinc-800 */
}

/* Trail: starts at the base of the launch pad and glows white behind the rocket */
.timeline-progress {
  top: 7px; /* bottom of the pad's platform */
  left: 6.5px;
  width: 2px;
  /* From the pad down to 12px short of the nose tip (hidden under the rocket);
     the nose tip sits at --start + progress × (timeline height − --start) */
  height: max(0px, calc(var(--start) - 7px - 12px + var(--progress, 0) * (100% - var(--start))));
  border-radius: 9999px;
  background: linear-gradient(to bottom, rgb(161 161 170 / 0.6) 0%, rgb(212 212 216 / 0.8) 40%, #fafafa 100%); /* zinc-400 → zinc-50 */
  filter: drop-shadow(0 0 4px rgb(250 250 250 / 0.45));
  overflow: hidden; /* keeps the pulse inside the trail */
}

/* Light pulse running down the trail, fading out as it reaches the rocket's engine */
.timeline-progress::after {
  content: "";
  position: absolute;
  left: 50%;
  width: 2px;
  height: 72px;
  translate: -50% 0;
  border-radius: 9999px;
  background: linear-gradient(to bottom, transparent, #ffffff, transparent);
  opacity: 0;
  animation: trail-pulse 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* The trail ends 12px inside the nose; the engine sits 68px above that,
   so the pulse's bottom edge stops at 100% - 68px (top = 100% - 68px - 72px) */
@keyframes trail-pulse {
  0% { top: -72px; opacity: 0; }
  15% { opacity: 1; }
  75% { opacity: 1; }
  100% { top: calc(100% - 140px); opacity: 0; }
}

/* Rocket flying down the rail, nose at the tip of the progress line */
.timeline-rocket {
  position: absolute;
  top: calc(var(--start) + var(--progress, 0) * (100% - var(--start)));
  left: 7.5px;
  z-index: 2;
  width: 24px;
  transform: translate(-50%, -100%) rotate(180deg);
  transition: transform 0.35s ease;
  pointer-events: none;
}

/* Scrolling up: nose points up, still anchored at the tip of the line */
.is-reversing .timeline-rocket {
  transform: translate(-50%, 0) rotate(0deg);
}

/* Docked in the pad clamps: always nose-down, engine off until launch */
.is-docked .timeline-rocket {
  transform: translate(-50%, -100%) rotate(180deg);
}

.timeline-rocket svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

/* Flame grows with scroll speed (--thrust is set by the script) */
.rocket-thrust {
  transform-box: fill-box;
  transform-origin: top center;
  transform: scaleY(calc(0.7 + var(--thrust, 0) * 1.1)) scaleX(calc(1 + var(--thrust, 0) * 0.25));
  transition: transform 0.25s ease-out;
}

.is-docked .rocket-thrust {
  transform: scale(0);
}

.rocket-flame {
  transform-box: fill-box;
  transform-origin: top center;
  animation: rocket-flicker 0.12s ease-in-out infinite alternate;
}

/* Milestone bullets: a ring with a dim core that lights up when the rocket passes */
.timeline-dot {
  position: absolute;
  top: 0.05rem;
  left: 0;
  z-index: 1;
  width: 15px;
  height: 15px;
  border: 1.5px solid #3f3f46; /* zinc-700 */
  border-radius: 9999px;
  background: #09090b; /* zinc-950 */
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
}

.timeline-dot::before {
  content: "";
  position: absolute;
  inset: 3.5px;
  border-radius: inherit;
  background: #3f3f46; /* zinc-700 */
  transition: background-color 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.timeline-dot::after {
  content: "";
  position: absolute;
  inset: -1.5px;
  border: 1.5px solid #f4f4f5; /* zinc-100 */
  border-radius: inherit;
  opacity: 0;
  pointer-events: none;
}

.is-reached .timeline-dot {
  border-color: #d4d4d8; /* zinc-300 */
  box-shadow: 0 0 12px rgb(244 244 245 / 0.2);
}

.is-reached .timeline-dot::before {
  background: #fafafa; /* zinc-50 */
  transform: scale(1.15);
}

/* One-time ripple when the rocket reaches a bullet */
.is-reached .timeline-dot::after {
  animation: dot-ping 0.9s ease-out;
}

.timeline-period {
  transition: color 0.4s ease;
}

.is-reached .timeline-period {
  color: #d4d4d8; /* zinc-300 */
}

/* Current role: sauce-red bullet with a continuous pulse (stays red even once reached) */
.timeline .timeline-dot.is-current {
  border-color: #ef4444; /* red-500 */
  box-shadow: 0 0 14px rgb(239 68 68 / 0.4);
}

.timeline .timeline-dot.is-current::before {
  background: #ef4444;
  transform: scale(1.15);
}

.timeline .timeline-dot.is-current::after {
  border-color: #ef4444;
  animation: dot-pulse 2s ease-out infinite;
}

@keyframes pad-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

@keyframes hint-bob {
  0%, 100% { translate: 0 -1px; }
  50% { translate: 0 2px; }
}

@keyframes rocket-flicker {
  from { transform: scale(1, 1); opacity: 1; }
  to { transform: scale(0.85, 0.8); opacity: 0.85; }
}

@keyframes dot-ping {
  from { transform: scale(1); opacity: 0.8; }
  to { transform: scale(2.6); opacity: 0; }
}

@keyframes dot-pulse {
  from { transform: scale(1); opacity: 0.7; }
  to { transform: scale(2.4); opacity: 0; }
}

/* Entries rise in as they scroll into view (only once the script has run) */
.reveal-ready .timeline-item {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal-ready .timeline-item.is-visible {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .timeline-dot,
  .timeline-dot::before,
  .timeline-period,
  .timeline-hint,
  .timeline-rocket,
  .rocket-thrust,
  .pad-clamp {
    transition: none;
  }

  .rocket-flame,
  .timeline-progress::after,
  .pad-beacon,
  .hint-arrow,
  .is-reached .timeline-dot::after,
  .timeline .timeline-dot.is-current::after {
    animation: none;
  }
}
</style>

<script>
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");

  if (timeline) {
    const items = [...timeline.querySelectorAll<HTMLElement>("[data-timeline-item]")];
    let frame = 0;
    let lastScrollY = window.scrollY;
    let coastTimer = 0;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Fill the rail up to 40% of the viewport height and light up the bullets it has passed
    const update = () => {
      frame = 0;
      const anchor = window.innerHeight * 0.4;
      const rect = timeline.getBoundingClientRect();
      const start = parseFloat(getComputedStyle(timeline).getPropertyValue("--start")) || 0;
      const progress = Math.min(Math.max((anchor - rect.top - start) / (rect.height - start), 0), 1);

      timeline.style.setProperty("--progress", progress.toFixed(4));
      timeline.classList.toggle("is-docked", progress === 0);

      // Faster scrolling = bigger flame; it settles back once scrolling stops
      const delta = window.scrollY - lastScrollY;
      const speed = Math.abs(delta);
      lastScrollY = window.scrollY;

      // Turn the rocket around to face the direction of travel
      if (speed > 2) timeline.classList.toggle("is-reversing", delta < 0);
      timeline.style.setProperty("--thrust", Math.min(speed / 40, 1).toFixed(2));
      clearTimeout(coastTimer);
      coastTimer = window.setTimeout(() => timeline.style.setProperty("--thrust", "0"), 120);

      for (const item of items) {
        const dot = item.querySelector("[data-timeline-dot]");
        if (dot) item.classList.toggle("is-reached", dot.getBoundingClientRect().top < anchor);
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();

    if (!reduceMotion && "IntersectionObserver" in window) {
      timeline.classList.add("reveal-ready");

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );

      items.forEach((item) => observer.observe(item));
    }
  }
</script>
