---
import { experience } from "../data/experience";
---

<section id="experience" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24" aria-label="Work experience">
   <div class="sticky top-0 z-20 -mx-6 mb-4 bg-zinc-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-100 lg:sr-only">Experience</h2>
   </div>
   <div>
      <div class="timeline relative" data-timeline>
         <span class="timeline-track" aria-hidden="true"></span>
         <span class="timeline-progress" aria-hidden="true"></span>
         <span class="timeline-rocket" aria-hidden="true">
            <svg viewBox="0 0 24 44" fill="none">
               <defs>
                  <linearGradient id="rocket-flame" x1="0" x2="0" y1="0" y2="1">
                     <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                     <stop offset="50%" stop-color="#e4e4e7" stop-opacity="0.5" />
                     <stop offset="100%" stop-color="#e4e4e7" stop-opacity="0" />
                  </linearGradient>
               </defs>
               <g class="rocket-thrust">
                  <g class="rocket-flame">
                     <path d="M9 31.5C9.8 37.5 11.2 42.5 12 44c.8-1.5 2.2-6.5 3-12.5Z" fill="url(#rocket-flame)" />
                     <path d="M10.6 31.5c.4 3.2 1 5.6 1.4 6.6.4-1 1-3.4 1.4-6.6Z" fill="#ffffff" />
                  </g>
               </g>
               <path d="M6.5 19C3.5 21 2 24.5 2 29.5V32l4.5-3Z" fill="#d4d4d8" />
               <path d="M17.5 19c3 2 4.5 5.5 4.5 10.5V32l-4.5-3Z" fill="#d4d4d8" />
               <path d="M12 1.5c4.5 4 5.5 10.5 5.5 18.5V29h-11v-9C6.5 12 7.5 5.5 12 1.5Z" fill="#fafafa" />
               <path d="M8.5 29h7l-1 2.5h-5Z" fill="#a1a1aa" />
               <rect x="11.25" y="23" width="1.5" height="9" rx="0.75" fill="#d4d4d8" />
               <circle cx="12" cy="13.5" r="2.6" fill="#09090b" stroke="#d4d4d8" stroke-width="0.9" />
            </svg>
         </span>
         <ol class="group/list">

         {experience.map((job) => (
            <li class="timeline-item relative mb-12 pl-9 last:mb-0 sm:pl-11" data-timeline-item>
               <span class:list={["timeline-dot", { "is-current": job.current }]} data-timeline-dot aria-hidden="true"></span>
               <div class="group relative pb-1 transition-all lg:hover:!opacity-100 lg:group-hover/list:opacity-50">
                  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-zinc-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(212,212,216,0.1)] lg:group-hover:drop-shadow-lg"></div>
                  <div class="relative z-10">
                     <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500" aria-label={job.periodLabel}>{job.period}</p>
                     <h3 class="mt-2 font-medium leading-snug text-zinc-100">
                        <a class="group/link inline-flex items-baseline text-base font-medium leading-tight text-zinc-100 hover:text-white focus-visible:text-white" href={job.url} target="_blank" rel="noreferrer noopener" aria-label={`${job.title} at ${job.company} (opens in a new tab)`}>
                           <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"></span>
                           <span>
                              {job.title} ·{" "}
                              <span class="inline-block">
                                 {job.company}
                                 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
                                 </svg>
                              </span>
                           </span>
                        </a>
                     </h3>

                     {job.previousTitles && (
                        <ul class="mt-1 space-y-0.5" aria-label="Previous roles">
                           {job.previousTitles.map((title) => (
                              <li class="flex items-center gap-2 text-sm text-zinc-500">
                                 <span class="h-px w-3 bg-zinc-700" aria-hidden="true"></span>
                                 {title}
                              </li>
                           ))}
                        </ul>
                     )}

                     <p class="mt-2 text-sm leading-normal">{job.description}</p>

                     {job.links && (
                        <ul class="mt-2 flex flex-wrap" aria-label="Related links">
                           {job.links.map((link) => (
                              <li class="mr-4">
                                 <a class="relative mt-2 inline-flex items-center text-sm font-medium text-zinc-300 hover:text-white focus-visible:text-white" href={link.url} target="_blank" rel="noreferrer noopener" aria-label={`${link.label} (opens in a new tab)`}>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mr-1 h-3 w-3" aria-hidden="true">
                                       <path d="M12.232 4.232a2.5 2.5 0 013.536 3.536l-1.225 1.224a.75.75 0 001.061 1.06l1.224-1.224a4 4 0 00-5.656-5.656l-3 3a4 4 0 00.225 5.865.75.75 0 00.977-1.138 2.5 2.5 0 01-.142-3.667l3-3z"></path>
                                       <path d="M11.603 7.963a.75.75 0 00-.977 1.138 2.5 2.5 0 01.142 3.667l-3 3a2.5 2.5 0 01-3.536-3.536l1.225-1.224a.75.75 0 00-1.061-1.06l-1.224 1.224a4 4 0 105.656 5.656l3-3a4 4 0 00-.225-5.865z"></path>
                                    </svg>
                                    <span>{link.label}</span>
                                 </a>
                              </li>
                           ))}
                        </ul>
                     )}

                     <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                        {job.tech.map((tech) => (
                           <li class="mr-1.5 mt-2">
                              <div class="flex items-center rounded-full bg-zinc-400/10 px-3 py-1 text-xs font-medium leading-5 text-zinc-300">{tech}</div>
                           </li>
                        ))}
                     </ul>
                  </div>
               </div>
            </li>
         ))}
         </ol>
      </div>

      <div class="mt-12">
         <a class="group/link inline-flex items-baseline text-base font-semibold leading-tight text-zinc-100 hover:text-white focus-visible:text-white" href="/resume.pdf" target="_blank" rel="noreferrer noopener" aria-label="View Full Résumé (opens in a new tab)">
            <span>
               View Full{" "}
               <span class="inline-block">
                  Résumé
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
                     <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path>
                  </svg>
               </span>
            </span>
         </a>
      </div>
   </div>
</section>

<style>
/* Rail: a faint track, plus a bright line that fills as you scroll */
.timeline-track,
.timeline-progress {
  position: absolute;
  top: 0.45rem;
  left: 7px;
  width: 1px;
  pointer-events: none;
}

.timeline-track {
  bottom: 0;
  background: linear-gradient(to bottom, #27272a 0%, #27272a 85%, transparent 100%); /* zinc-800 */
}

.timeline-progress {
  height: calc(var(--progress, 0) * (100% - 0.45rem));
  background: linear-gradient(to bottom, #52525b, #f4f4f5); /* zinc-600 → zinc-100 */
}

/* Rocket flying down the rail, nose at the tip of the progress line */
.timeline-rocket {
  position: absolute;
  top: calc(0.45rem + var(--progress, 0) * (100% - 0.45rem));
  left: 7.5px;
  z-index: 2;
  width: 20px;
  transform: translate(-50%, -100%) rotate(180deg);
  opacity: var(--rocket, 0);
  filter: drop-shadow(0 0 6px rgb(250 250 250 / 0.35));
  transition: opacity 0.3s ease, transform 0.35s ease;
  pointer-events: none;
}

/* Scrolling up: nose points up, still anchored at the tip of the line */
.is-reversing .timeline-rocket {
  transform: translate(-50%, 0) rotate(0deg);
}

.timeline-rocket svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

/* Flame grows with scroll speed (--thrust is set by the script) */
.rocket-thrust {
  transform-box: fill-box;
  transform-origin: top center;
  transform: scaleY(calc(0.7 + var(--thrust, 0) * 1.1)) scaleX(calc(1 + var(--thrust, 0) * 0.25));
  transition: transform 0.25s ease-out;
}

.rocket-flame {
  transform-box: fill-box;
  transform-origin: top center;
  animation: rocket-flicker 0.12s ease-in-out infinite alternate;
}

@keyframes rocket-flicker {
  from { transform: scale(1, 1); opacity: 1; }
  to { transform: scale(0.85, 0.8); opacity: 0.85; }
}

/* Milestone dots light up once the progress line reaches them */
.timeline-dot {
  position: absolute;
  top: 0.05rem;
  left: 0;
  z-index: 1;
  width: 15px;
  height: 15px;
  border: 2px solid #3f3f46; /* zinc-700 */
  border-radius: 9999px;
  background: #09090b; /* zinc-950 */
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
}

.timeline-dot::before {
  content: "";
  position: absolute;
  inset: 2px;
  border-radius: inherit;
  background: #f4f4f5; /* zinc-100 */
  transform: scale(0);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.is-reached .timeline-dot {
  border-color: #e4e4e7; /* zinc-200 */
  box-shadow: 0 0 12px rgb(244 244 245 / 0.25);
}

.is-reached .timeline-dot::before {
  transform: scale(1);
}

/* Current role: sauce-red dot with a pulse */
.timeline-dot.is-current {
  border-color: #ef4444; /* red-500 */
}

.timeline-dot.is-current::before {
  background: #ef4444;
  transform: scale(1);
}

.timeline-dot.is-current::after {
  content: "";
  position: absolute;
  inset: -2px;
  border: 2px solid #ef4444;
  border-radius: inherit;
  animation: timeline-pulse 2s ease-out infinite;
}

.is-reached .timeline-dot.is-current {
  box-shadow: 0 0 14px rgb(239 68 68 / 0.45);
}

@keyframes timeline-pulse {
  from { transform: scale(1); opacity: 0.7; }
  to { transform: scale(2.4); opacity: 0; }
}

/* Entries rise in as they scroll into view (only once the script has run) */
.reveal-ready .timeline-item {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal-ready .timeline-item.is-visible {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .timeline-dot,
  .timeline-dot::before,
  .timeline-rocket,
  .rocket-thrust {
    transition: none;
  }

  .rocket-flame {
    animation: none;
  }

  .timeline-dot.is-current::after {
    animation: none;
    opacity: 0;
  }
}
</style>

<script>
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");

  if (timeline) {
    const items = [...timeline.querySelectorAll<HTMLElement>("[data-timeline-item]")];
    let frame = 0;
    let lastScrollY = window.scrollY;
    let coastTimer = 0;

    // Fill the rail up to 60% of the viewport height and light up the dots it has passed
    const update = () => {
      frame = 0;
      const anchor = window.innerHeight * 0.6;
      const rect = timeline.getBoundingClientRect();
      const progress = Math.min(Math.max((anchor - rect.top) / rect.height, 0), 1);

      timeline.style.setProperty("--progress", progress.toFixed(4));
      timeline.style.setProperty("--rocket", progress > 0 ? "1" : "0");

      // Faster scrolling = bigger flame; it settles back once scrolling stops
      const delta = window.scrollY - lastScrollY;
      const speed = Math.abs(delta);
      lastScrollY = window.scrollY;

      // Turn the rocket around to face the direction of travel
      if (speed > 2) timeline.classList.toggle("is-reversing", delta < 0);
      timeline.style.setProperty("--thrust", Math.min(speed / 40, 1).toFixed(2));
      clearTimeout(coastTimer);
      coastTimer = window.setTimeout(() => timeline.style.setProperty("--thrust", "0"), 120);

      for (const item of items) {
        const dot = item.querySelector("[data-timeline-dot]");
        if (dot) item.classList.toggle("is-reached", dot.getBoundingClientRect().top < anchor);
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduceMotion && "IntersectionObserver" in window) {
      timeline.classList.add("reveal-ready");

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );

      items.forEach((item) => observer.observe(item));
    }
  }
</script>
