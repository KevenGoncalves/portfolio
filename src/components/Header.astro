---
import ProfileImage from "../assets/profile.png";
import { Image } from "astro:assets";
import Sauce from "./Sauce.astro";
import { siGithub } from "simple-icons";
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:overflow-y-auto lg:py-[clamp(3rem,8vh,6rem)]">
  <div>
    <div class="relative mb-10 max-w-56 sm:max-w-64 lg:mb-8 lg:max-w-[min(18rem,26vh)] lg:short:max-w-40">
        <div class="absolute inset-0 border border-zinc-500 translate-x-4 translate-y-4"></div>
        <div class="relative bg-zinc-200">
          <Image
            src={ProfileImage}
            alt="Portrait"
            class="w-full h-auto object-cover grayscale"
          />
        </div>
      </div>
  </div>
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-zinc-100 sm:text-5xl font-[Oxanium]"><a href="/">Keven Gonçalves</a></h1>
    <h2 class="mt-3 text-lg font-medium tracking-tight text-zinc-100 sm:text-xl flex items-center">
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M305-208 32-480l273-273 90 89-184 184 183 183-89 89Zm350 1-90-89 184-184-183-183 89-89 273 272-273 273Z"/></svg>
        Backend & Mobile Developer
      </span>
    </h2>
    <p class="mt-8 max-w-xs leading-normal">
      I make <Sauce />, but not in the kitchen
    </p>
     <nav class="nav hidden lg:block" aria-label="In-page jump links">
        <ul class="mt-12 w-max lg:short:mt-8">
           <li><a class="group flex items-center py-3 lg:short:py-2" href="#about"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">About</span></a></li>
           <li><a class="group flex items-center py-3 lg:short:py-2" href="#experience"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">Experience</span></a></li>
           <li><a class="group flex items-center py-3 lg:short:py-2 active" href="#projects"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">Projects</span></a></li>
           <li><a class="group flex items-center py-3 lg:short:py-2" href="#contact"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">Contact</span></a></li>
        </ul>
     </nav>
  </div>
  <ul class="ml-1 mt-8 flex items-center" aria-label="Social media">
     <li class="mr-5 shrink-0 text-xs">
        <a class="block hover:text-zinc-100" href="https://github.com/KevenGoncalves" target="_blank" rel="noreferrer noopener" aria-label="GitHub (opens in a new tab)" title="GitHub">
           <span class="sr-only">GitHub</span>
           <!-- Square GitHub logo: rounded square with the Octocat cut out (masked from the official mark) -->
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
              <mask id="github-square-cutout">
                 <rect width="24" height="24" rx="3" fill="white"></rect>
                 <g transform="translate(2.4 2.64) scale(0.8)">
                    <circle cx="12" cy="12" r="11.4" fill="black"></circle>
                    <path d={siGithub.path} fill="white"></path>
                 </g>
              </mask>
              <rect width="24" height="24" rx="3" mask="url(#github-square-cutout)"></rect>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="block hover:text-zinc-100" href="https://www.linkedin.com/in/keven-gon%C3%A7alves-5867661a9/" target="_blank" rel="noreferrer noopener" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
           <span class="sr-only">LinkedIn</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="2 2 20 20" fill="currentColor" class="h-6 w-6" aria-hidden="true">
              <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="block hover:text-zinc-100" href="https://www.instagram.com/keven_gamero" target="_blank" rel="noreferrer noopener" aria-label="Instagram (opens in a new tab)" title="Instagram">
           <span class="sr-only">Instagram</span>
           <!-- Square Instagram logo: rounded square with the camera outline, lens and flash cut out -->
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
              <mask id="instagram-square-cutout">
                 <rect width="24" height="24" rx="3" fill="white"></rect>
                 <rect x="4.25" y="4.25" width="15.5" height="15.5" rx="4.5" fill="none" stroke="black" stroke-width="1.9"></rect>
                 <circle cx="12" cy="12" r="3.7" fill="none" stroke="black" stroke-width="1.9"></circle>
                 <circle cx="16.4" cy="7.6" r="1.15" fill="black"></circle>
              </mask>
              <rect width="24" height="24" rx="3" mask="url(#instagram-square-cutout)"></rect>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="block hover:text-zinc-100" href="https://www.facebook.com/keven.goncalves.148" target="_blank" rel="noreferrer noopener" aria-label="Facebook (opens in a new tab)" title="Facebook">
           <span class="sr-only">Facebook</span>
           <!-- Classic square Facebook logo: rounded square with the "f" cut out -->
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="2 2 20 20" fill="currentColor" class="h-6 w-6" aria-hidden="true">
              <path fill-rule="evenodd" d="M4.5 2h15A2.5 2.5 0 0 1 22 4.5v15a2.5 2.5 0 0 1-2.5 2.5h-3.3v-8.2h2.7l.4-2.8h-3.1V9.2c0-.8.4-1.6 1.6-1.6h1.2V5.2s-1.1-.2-2.2-.2C14.5 5 13 6.4 13 8.9V11h-2.5v2.8H13V22H4.5A2.5 2.5 0 0 1 2 19.5v-15A2.5 2.5 0 0 1 4.5 2Z"></path>
           </svg>
        </a>
     </li>
  </ul>
</header>
