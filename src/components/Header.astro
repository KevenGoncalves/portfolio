---
import ProfileImage from "../assets/profile.png";
import { Image } from "astro:assets";
import Sauce from "./Sauce.astro";
import { langPath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:overflow-y-auto lg:py-[clamp(3rem,8vh,6rem)]">
  <div>
    <div class="relative mb-10 max-w-56 sm:max-w-64 lg:mb-8 lg:max-w-[min(18rem,26vh)] lg:short:max-w-40">
        <div class="absolute inset-0 border border-zinc-500 translate-x-4 translate-y-4"></div>
        <div class="relative bg-zinc-200">
          <Image
            src={ProfileImage}
            alt="Portrait"
            class="w-full h-auto object-cover grayscale"
          />
        </div>
      </div>
  </div>
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-zinc-100 sm:text-5xl font-[Oxanium]"><a href={langPath[lang]}>Keven Gonçalves</a></h1>
    <h2 class="mt-3 text-lg font-medium tracking-tight text-zinc-100 sm:text-xl flex items-center">
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M305-208 32-480l273-273 90 89-184 184 183 183-89 89Zm350 1-90-89 184-184-183-183 89-89 273 272-273 273Z"/></svg>
        {t("header.role")}
      </span>
    </h2>
    <p class="mt-8 max-w-xs leading-normal">
      {t("header.tagline.before")} <Sauce />{t("header.tagline.after")}
    </p>
     <nav class="nav hidden lg:block" aria-label={t("nav.label")}>
        <ul class="mt-12 w-max lg:short:mt-8">
           <li><a class="group flex items-center py-3 lg:short:py-2" href="#about"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.about")}</span></a></li>
           <li><a class="group flex items-center py-3 lg:short:py-2" href="#experience"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.experience")}</span></a></li>
           <li><a class="group flex items-center py-3 lg:short:py-2 active" href="#projects"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.projects")}</span></a></li>
           <li><a class="group flex items-center py-3 lg:short:py-2" href="#contact"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.contact")}</span></a></li>
        </ul>
     </nav>
  </div>
  <!-- Social links: Tabler outline brand icons (MIT) -->
  <ul class="ml-1 mt-8 flex items-center" aria-label={t("social.label")}>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://github.com/KevenGoncalves" target="_blank" rel="noreferrer noopener" aria-label={`GitHub ${t("newTab")}`} title="GitHub">
           <span class="sr-only">GitHub</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://www.linkedin.com/in/keven-gon%C3%A7alves-5867661a9/" target="_blank" rel="noreferrer noopener" aria-label={`LinkedIn ${t("newTab")}`} title="LinkedIn">
           <span class="sr-only">LinkedIn</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"></path><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://www.instagram.com/keven_gamero" target="_blank" rel="noreferrer noopener" aria-label={`Instagram ${t("newTab")}`} title="Instagram">
           <span class="sr-only">Instagram</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <!-- Tabler draws Instagram at 16 units vs 18 for the others: scale it up to match, keeping the 2px line -->
              <g transform="translate(12 12) scale(1.125) translate(-12 -12)"><path vector-effect="non-scaling-stroke" d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"></path><path vector-effect="non-scaling-stroke" d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path vector-effect="non-scaling-stroke" d="M16.5 7.5v.01"></path></g>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://www.facebook.com/keven.goncalves.148" target="_blank" rel="noreferrer noopener" aria-label={`Facebook ${t("newTab")}`} title="Facebook">
           <span class="sr-only">Facebook</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"></path>
           </svg>
        </a>
     </li>
  </ul>
</header>

<style>
/* Social icons: a quick glitch on hover (same idea as "video games" in About):
   the icon skews and jolts while red and grey ghost copies split off, then snaps back */
.social-link:hover svg,
.social-link:focus-visible svg {
  animation: social-glitch 0.45s steps(1, end);
}

@keyframes social-glitch {
  0% {
    transform: translate(1px, 0) skewX(-8deg);
    filter: drop-shadow(2px 0 var(--color-red-400)) drop-shadow(-2px 0 var(--color-zinc-600));
  }
  25% {
    transform: translate(-2px, 0) skewX(6deg);
    filter: drop-shadow(-2px 0 var(--color-red-400)) drop-shadow(2px 0 var(--color-zinc-600));
  }
  50% {
    transform: translate(1px, -1px);
    filter: drop-shadow(1px 1px var(--color-red-400)) drop-shadow(-1px -1px var(--color-zinc-600));
  }
  75% {
    transform: none;
    filter: drop-shadow(-1px 0 var(--color-red-400));
  }
  100% {
    transform: none;
    filter: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .social-link:hover svg,
  .social-link:focus-visible svg {
    animation: none;
  }
}
</style>
