---
import ProfileImage from "../assets/profile.png";
import { getImage } from "astro:assets";
import Sauce from "./Sauce.astro";
import { langPath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// One optimised photo, used by the <img> and by the glitch copies (so it's only downloaded once)
const photo = await getImage({ src: ProfileImage });
// It's at the top of the page, so it loads right away (Astro defaults images to lazy)
const { loading: _lazy, ...photoAttributes } = photo.attributes;
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:overflow-y-auto lg:py-[clamp(3rem,8vh,6rem)]">
  <div>
    <div class="relative mb-10 max-w-56 sm:max-w-64 lg:mb-8 lg:max-w-[min(18rem,26vh)] lg:short:max-w-40">
        <div class="absolute inset-0 border border-zinc-500 translate-x-4 translate-y-4"></div>
        <div class="photo-glitch relative bg-zinc-200" style={`--photo: url("${photo.src}")`}>
          <img
            src={photo.src}
            {...photoAttributes}
            loading="eager"
            fetchpriority="high"
            alt="Keven Gonçalves"
            class="w-full h-auto object-cover grayscale"
          />
        </div>
      </div>
  </div>
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-zinc-100 sm:text-5xl font-[Oxanium]"><a class="name-glitch" href={langPath[lang]} data-text="Keven Gonçalves">Keven Gonçalves</a></h1>
    <h2 class="mt-3 text-lg font-medium tracking-tight text-zinc-100 sm:text-xl flex items-center">
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M305-208 32-480l273-273 90 89-184 184 183 183-89 89Zm350 1-90-89 184-184-183-183 89-89 273 272-273 273Z"/></svg>
        {t("header.role")}
      </span>
    </h2>
    <p class="mt-8 max-w-xs leading-normal">
      {t("header.tagline.before")} <Sauce />{t("header.tagline.after")}
    </p>
     <nav class="nav hidden lg:block" aria-label={t("nav.label")}>
        <ul class="mt-12 w-max lg:short:mt-8">
           <li><a class="nav-link group flex items-center py-3 lg:short:py-2" data-nav-link href="#about"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.about")}</span></a></li>
           <li><a class="nav-link group flex items-center py-3 lg:short:py-2" data-nav-link href="#experience"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.experience")}</span></a></li>
           <li><a class="nav-link group flex items-center py-3 lg:short:py-2" data-nav-link href="#projects"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.projects")}</span></a></li>
           <li><a class="nav-link group flex items-center py-3 lg:short:py-2" data-nav-link href="#contact"><span class="nav-indicator mr-4 h-px w-8 bg-zinc-600 transition-all group-hover:w-16 group-hover:bg-zinc-200 group-focus-visible:w-16 group-focus-visible:bg-zinc-200 motion-reduce:transition-none"></span><span class="nav-text text-xs font-bold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-100 group-focus-visible:text-zinc-100">{t("nav.contact")}</span></a></li>
        </ul>
     </nav>
  </div>
  <!-- Social links: Tabler outline brand icons (MIT) -->
  <ul class="ml-1 mt-8 flex items-center" aria-label={t("social.label")}>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://github.com/KevenGoncalves" target="_blank" rel="noreferrer noopener" aria-label={`GitHub ${t("newTab")}`} title="GitHub">
           <span class="sr-only">GitHub</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://www.linkedin.com/in/keven-gon%C3%A7alves-5867661a9/" target="_blank" rel="noreferrer noopener" aria-label={`LinkedIn ${t("newTab")}`} title="LinkedIn">
           <span class="sr-only">LinkedIn</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M8 11v5"></path><path d="M8 8v.01"></path><path d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"></path><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://www.instagram.com/keven_gamero" target="_blank" rel="noreferrer noopener" aria-label={`Instagram ${t("newTab")}`} title="Instagram">
           <span class="sr-only">Instagram</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <!-- Tabler draws Instagram at 16 units vs 18 for the others: scale it up to match, keeping the 2px line -->
              <g transform="translate(12 12) scale(1.125) translate(-12 -12)"><path vector-effect="non-scaling-stroke" d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"></path><path vector-effect="non-scaling-stroke" d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path vector-effect="non-scaling-stroke" d="M16.5 7.5v.01"></path></g>
           </svg>
        </a>
     </li>
     <li class="mr-5 shrink-0 text-xs">
        <a class="social-link block hover:text-zinc-100 focus-visible:text-zinc-100" href="https://www.facebook.com/keven.goncalves.148" target="_blank" rel="noreferrer noopener" aria-label={`Facebook ${t("newTab")}`} title="Facebook">
           <span class="sr-only">Facebook</span>
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"></path>
           </svg>
        </a>
     </li>
  </ul>
</header>

<style>
/* Name: the same RGB-split glitch as the 404 page, scaled to the heading.
   Cyan/red ghosts sit on either side, and every few seconds a slice tears sideways */
.name-glitch {
  position: relative;
  display: inline-block;
  text-shadow: -0.04em 0 var(--glitch-blue), 0.04em 0 var(--glitch-red);
}

.name-glitch::before,
.name-glitch::after {
  content: attr(data-text);
  content: attr(data-text) / ""; /* decorative copies, hidden from screen readers */
  position: absolute;
  inset: 0;
  clip-path: inset(0 0 100% 0);
  pointer-events: none;
}

.name-glitch::before {
  animation: name-tear-a 3.6s steps(1, end) infinite;
}

.name-glitch::after {
  animation: name-tear-b 3.6s steps(1, end) infinite;
}

@keyframes name-tear-a {
  0%, 86%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
  88% { clip-path: inset(18% 0 62% 0); transform: translateX(-0.12em); }
  91% { clip-path: inset(55% 0 30% 0); transform: translateX(0.1em); }
  94% { clip-path: inset(30% 0 55% 0); transform: translateX(-0.06em); }
}

@keyframes name-tear-b {
  0%, 86%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
  88% { clip-path: inset(68% 0 12% 0); transform: translateX(0.11em); }
  91% { clip-path: inset(8% 0 78% 0); transform: translateX(-0.09em); }
  94% { clip-path: inset(80% 0 4% 0); transform: translateX(0.05em); }
}

@media (prefers-reduced-motion: reduce) {
  .name-glitch::before,
  .name-glitch::after {
    animation: none;
  }
}

/* Nav: the link for the section on screen is highlighted (long bright line, bright text), set by the script below */
.nav-link.is-active .nav-indicator {
  width: 4rem;
  background-color: var(--color-zinc-200);
}

.nav-link.is-active .nav-text {
  color: var(--color-zinc-100);
}

/* Photo: RGB-split glitch on hover. Two copies of the photo (tinted cyan and red, screened over it)
   tear apart in horizontal slices while the photo jolts, then it snaps back to the clean photo. */
.photo-glitch {
  overflow: hidden;
}

.photo-glitch::before,
.photo-glitch::after {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--photo) center / cover no-repeat;
  background-blend-mode: luminosity; /* the photo's light and shade, in the tint colour */
  mix-blend-mode: screen;
  opacity: 0;
  pointer-events: none;
}

.photo-glitch::before {
  background-color: var(--glitch-blue);
}

.photo-glitch::after {
  background-color: var(--glitch-red);
}

.photo-glitch:hover::before {
  animation: photo-glitch-cyan 0.6s steps(1, end);
}

.photo-glitch:hover::after {
  animation: photo-glitch-red 0.6s steps(1, end);
}

.photo-glitch:hover img {
  animation: photo-glitch-jolt 0.6s steps(1, end);
}

@keyframes photo-glitch-cyan {
  0% { opacity: 0.8; transform: translateX(-12px); clip-path: inset(8% 0 62% 0); }
  15% { transform: translateX(9px); clip-path: inset(55% 0 20% 0); }
  30% { transform: translateX(-7px); clip-path: inset(20% 0 45% 0); }
  45% { transform: translateX(5px); clip-path: inset(70% 0 6% 0); }
  60% { opacity: 0.6; transform: translateX(-6px); clip-path: inset(0 0 0 0); }
  80% { opacity: 0.35; transform: translateX(-3px); clip-path: inset(0 0 0 0); }
  100% { opacity: 0; transform: none; }
}

@keyframes photo-glitch-red {
  0% { opacity: 0.8; transform: translateX(10px); clip-path: inset(40% 0 35% 0); }
  15% { transform: translateX(-11px); clip-path: inset(12% 0 70% 0); }
  30% { transform: translateX(8px); clip-path: inset(62% 0 14% 0); }
  45% { transform: translateX(-6px); clip-path: inset(30% 0 52% 0); }
  60% { opacity: 0.6; transform: translateX(6px); clip-path: inset(0 0 0 0); }
  80% { opacity: 0.35; transform: translateX(3px); clip-path: inset(0 0 0 0); }
  100% { opacity: 0; transform: none; }
}

@keyframes photo-glitch-jolt {
  0% { transform: translateX(4px) skewX(-3deg); clip-path: polygon(0 0, 100% 0, 100% 30%, 0 30%, 0 38%, 100% 38%, 100% 100%, 0 100%); }
  15% { transform: translateX(-5px) skewX(2deg); clip-path: polygon(0 0, 100% 0, 100% 58%, 0 58%, 0 66%, 100% 66%, 100% 100%, 0 100%); }
  30% { transform: translateX(3px); clip-path: polygon(0 0, 100% 0, 100% 14%, 0 14%, 0 19%, 100% 19%, 100% 100%, 0 100%); }
  45% { transform: translateX(-2px); clip-path: none; }
  60%, 100% { transform: none; clip-path: none; }
}

@media (prefers-reduced-motion: reduce) {
  .photo-glitch:hover::before,
  .photo-glitch:hover::after,
  .photo-glitch:hover img {
    animation: none;
  }
}

/* Social icons: the same RGB split as "video games" in About — cyan peeks out on the left, red on the right,
   with a quick jolt on hover before the icon settles (the split stays while hovered) */
.social-link:hover svg,
.social-link:focus-visible svg {
  filter: drop-shadow(-1.5px 0 var(--glitch-blue)) drop-shadow(1.5px 0 var(--glitch-red));
  animation: social-glitch 0.45s steps(1, end);
}

@keyframes social-glitch {
  0% {
    transform: translateX(2px) skewX(-8deg);
    filter: drop-shadow(-3px 0 var(--glitch-blue)) drop-shadow(3px 0 var(--glitch-red));
    clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%, 0 50%, 100% 50%, 100% 100%, 0 100%);
  }
  25% {
    transform: translateX(-2px) skewX(6deg);
    filter: drop-shadow(-2.5px 0 var(--glitch-blue)) drop-shadow(2.5px 0 var(--glitch-red));
    clip-path: polygon(0 0, 100% 0, 100% 62%, 0 62%, 0 74%, 100% 74%, 100% 100%, 0 100%);
  }
  50% {
    transform: translateX(1px);
    filter: drop-shadow(-2px 0 var(--glitch-blue)) drop-shadow(2px 0 var(--glitch-red));
    clip-path: polygon(0 0, 100% 0, 100% 18%, 0 18%, 0 28%, 100% 28%, 100% 100%, 0 100%);
  }
  75%, 100% {
    transform: none;
    clip-path: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .social-link:hover svg,
  .social-link:focus-visible svg {
    animation: none;
  }
}
</style>

<script>
  // Scroll-spy: highlight the nav link of the section currently on screen
  // (the last section whose top has passed 40% of the viewport; the last one once the page bottom is reached)
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  if (links.length && sections.length === links.length) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.4;
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let current = 0;
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= line) current = index;
      });
      if (atBottom) current = sections.length - 1;
      links.forEach((link, index) => {
        const active = index === current;
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>
