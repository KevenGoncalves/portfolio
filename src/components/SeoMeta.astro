---
/*
  Search and link-preview tags: description, canonical URL, EN/PT alternates, Open Graph and Twitter cards.
  Absolute URLs come from `site` in astro.config.mjs.
*/
import { languages, type Lang } from "../i18n/ui";

interface Props {
   lang: Lang;
   /** Preview title (the <title> itself stays "Keven Gonçalves") */
   title: string;
   description: string;
   /** This page's path in each language, e.g. { en: "/", pt: "/pt/" } */
   paths: Record<Lang, string>;
}

const { lang, title, description, paths } = Astro.props;
const base = Astro.site ?? Astro.url;
const url = (path: string) => new URL(path, base).href;
const ogLocale: Record<Lang, string> = { en: "en_US", pt: "pt_PT" };
const image = url("/og.png");
---

<meta name="description" content={description} />
<link rel="canonical" href={url(paths[lang])} />
{(Object.keys(languages) as Lang[]).map((code) => <link rel="alternate" hreflang={code} href={url(paths[code])} />)}
<link rel="alternate" hreflang="x-default" href={url(paths.en)} />
<link rel="sitemap" href="/sitemap.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Keven Gonçalves" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url(paths[lang])} />
<meta property="og:locale" content={ogLocale[lang]} />
{(Object.keys(languages) as Lang[]).filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={ogLocale[code]} />)}
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
