<!--
  Circular reveal between pages (language switch, opening/leaving the résumé), like the theme toggle.
  Links marked `data-reveal` remember where they were clicked; on the next page the new view grows out of
  that point as a circle (cross-document view transition, opted into with @view-transition in global.css).
  Must stay in <head>: `pagereveal` fires before the first frame of the new page.
  Browsers without cross-document view transitions just navigate normally.
-->
<script is:inline>
   (() => {
      const KEY = "reveal-origin";

      // Old page: remember the click point of a reveal link (viewport coordinates)
      document.addEventListener(
         "click",
         (event) => {
            const link = event.target instanceof Element && event.target.closest("a[data-reveal]");
            if (!link || link.getAttribute("aria-current") === "page") return;
            const box = link.getBoundingClientRect();
            const x = event.clientX || box.left + box.width / 2;
            const y = event.clientY || box.top + box.height / 2;
            try {
               sessionStorage.setItem(KEY, JSON.stringify({ x, y, at: Date.now() }));
            } catch {}
         },
         true,
      );

      // New page: grow the new view out of the remembered point; any other navigation (back/forward,
      // typed URL, a stale click from a few seconds ago) just swaps. The point is always used up here.
      window.addEventListener("pagereveal", (event) => {
         let origin = null;
         try {
            origin = JSON.parse(sessionStorage.getItem(KEY) || "null");
            sessionStorage.removeItem(KEY);
         } catch {}
         const transition = event.viewTransition;
         if (!transition) return;
         const fresh = origin && Date.now() - origin.at < 5000;
         if (!fresh || matchMedia("(prefers-reduced-motion: reduce)").matches) {
            transition.skipTransition();
            return;
         }
         const { x, y } = origin;
         const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
         transition.ready.then(() => {
            document.documentElement.animate(
               { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
               { duration: 650, easing: "cubic-bezier(0.4, 0, 0.2, 1)", pseudoElement: "::view-transition-new(root)" },
            );
         });
      });
   })();
</script>
