---
interface Props {
  /** Shown before the title, e.g. "01" */
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<!-- Sticky blurred bar on small screens; a plain heading with a fading rule on desktop -->
<div class="sticky top-0 z-20 -mx-6 mb-4 flex items-center gap-3 bg-zinc-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:static lg:z-auto lg:mx-0 lg:mb-10 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none">
  <span class="font-[Oxanium] text-xs font-semibold text-zinc-500" aria-hidden="true">{number}</span>
  <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-100">{title}</h2>
  <span class="h-px flex-1 bg-gradient-to-r from-zinc-700 to-transparent" aria-hidden="true"></span>
</div>
