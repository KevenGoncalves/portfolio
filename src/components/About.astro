---
import SectionHeading from "./SectionHeading.astro";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
   lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const strong = "font-medium text-zinc-100";
---

<section id="about" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24" aria-label={t("about.label")}>
   <SectionHeading number="01" title={t("nav.about")} />
   {lang === "pt" ? (
      <div>
         <p class="mb-4">
            Sou um desenvolvedor movido pela curiosidade de perceber como as coisas realmente funcionam — desde os detalhes de baixo nível até ao design de alto nível. Gosto de mergulhar a fundo para compreender um sistema por dentro e por fora e, depois, usar esse conhecimento para construir coisas incríveis para pessoas incríveis.
         </p>
         <p class="mb-4">
            Atualmente, sou Desenvolvedor de Software na{" "}<span class={strong}>Cornelder de Moçambique</span>, focado em desenvolvimento mobile com tecnologias nativas, criando aplicações rápidas e fiáveis que se sentem em casa em qualquer dispositivo.
         </p>
         <p class="mb-4">
            Antes disso, trabalhei sobretudo como{" "}<span class={strong}>desenvolvedor full-stack</span>{" "}tanto para{" "}<span class={strong}>empresas consolidadas</span>{" "}como para{" "}<span class={strong}>startups</span>, levando funcionalidades da base de dados até à interface.
         </p>
         <p>
            Fora do trabalho, passo o meu tempo livre com a minha família e a jogar os meus adorados{" "}<span class={`glitch ${strong}`} data-text="videojogos">videojogos</span>.
         </p>
      </div>
   ) : (
      <div>
         <p class="mb-4">
            I’m a developer driven by curiosity about how things really work — from the low-level details all the way up to the high-level design. I love digging deep to understand a system inside and out, then using that knowledge to build great things for great people.
         </p>
         <p class="mb-4">
            Currently, I’m a Software Developer at{" "}<span class={strong}>Cornelder de Moçambique</span>, focused on mobile development with native technologies, building fast, reliable apps that feel right at home on every device.
         </p>
         <p class="mb-4">
            In the past, I worked mainly as a{" "}<span class={strong}>full-stack developer</span>{" "}for both{" "}<span class={strong}>established companies</span>{" "}and{" "}<span class={strong}>startups</span>, taking features from the database all the way to the interface.
         </p>
         <p>
            Outside of work, I spend my free time with my family and playing my beloved{" "}<span class={`glitch ${strong}`} data-text="video games">video games</span>.
         </p>
      </div>
   )}
</section>

<style>
/* Glitch on hover: the words jitter and split into sauce-red and zinc ghost copies */
.glitch {
  position: relative;
  display: inline-block;
}

.glitch::before,
.glitch::after {
  content: attr(data-text);
  content: attr(data-text) / ""; /* hide the copies from screen readers */
  position: absolute;
  inset: 0;
  clip-path: inset(0 0 100% 0);
  pointer-events: none;
}

.glitch::before {
  color: #ef4444; /* red-500, same as the sauce */
}

.glitch::after {
  color: var(--color-zinc-400); /* zinc-400 */
}

.glitch:hover {
  animation: glitch-shake 0.5s steps(1, end);
}

.glitch:hover::before {
  animation: glitch-slice-a 0.5s steps(1, end);
}

.glitch:hover::after {
  animation: glitch-slice-b 0.5s steps(1, end);
}

@keyframes glitch-shake {
  0% { transform: translate(1px, 0) skewX(-6deg); }
  20% { transform: translate(-2px, 0) skewX(4deg); }
  40% { transform: translate(1px, 0) skewX(-2deg); }
  60% { transform: translate(-1px, 0) skewX(0); }
  80%, 100% { transform: none; }
}

@keyframes glitch-slice-a {
  0% { clip-path: inset(10% 0 55% 0); transform: translate(-3px, -1px); }
  20% { clip-path: inset(60% 0 8% 0); transform: translate(3px, 1px); }
  40% { clip-path: inset(30% 0 40% 0); transform: translate(-2px, 0); }
  60% { clip-path: inset(75% 0 5% 0); transform: translate(2px, -1px); }
  80% { clip-path: inset(5% 0 80% 0); transform: translate(-1px, 0); }
  100% { clip-path: inset(0 0 100% 0); transform: none; }
}

@keyframes glitch-slice-b {
  0% { clip-path: inset(65% 0 10% 0); transform: translate(3px, 1px); }
  20% { clip-path: inset(15% 0 60% 0); transform: translate(-3px, 0); }
  40% { clip-path: inset(45% 0 30% 0); transform: translate(2px, 1px); }
  60% { clip-path: inset(0 0 75% 0); transform: translate(-2px, 0); }
  80% { clip-path: inset(80% 0 0 0); transform: translate(1px, -1px); }
  100% { clip-path: inset(0 0 100% 0); transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  .glitch:hover,
  .glitch:hover::before,
  .glitch:hover::after {
    animation: none;
  }
}
</style>
