---
// Rainbow hover for "video games" (full class names so Tailwind picks them up)
const gameColors = [
   "group-hover/games:text-red-400",
   "group-hover/games:text-orange-400",
   "group-hover/games:text-yellow-400",
   "group-hover/games:text-lime-400",
   "group-hover/games:text-green-400",
   "group-hover/games:text-emerald-400",
   "group-hover/games:text-cyan-400",
   "group-hover/games:text-sky-400",
   "group-hover/games:text-blue-400",
   "group-hover/games:text-indigo-400",
   "group-hover/games:text-violet-400",
];
const gameLetters = [..."video games"];
---

<section id="about" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24" aria-label="About me">
   <div class="sticky top-0 z-20 -mx-6 mb-4 bg-zinc-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-100 lg:sr-only">About</h2>
   </div>
   <div>
      <p class="mb-4">
         I’m a developer driven by curiosity about how things really work — from the low-level details all the way up to the high-level design. I love digging deep to understand a system inside and out, then using that knowledge to build great things for great people.
      </p>
      <p class="mb-4">
         Currently, I’m a Software Developer at{" "}<span class="font-medium text-zinc-100">Cornelder de Moçambique</span>, focused on mobile development with native technologies, building fast, reliable apps that feel right at home on every device.
      </p>
      <p class="mb-4">
         In the past, I worked mainly as a{" "}<span class="font-medium text-zinc-100">full-stack developer</span>{" "}for both{" "}<span class="font-medium text-zinc-100">established companies</span>{" "}and{" "}<span class="font-medium text-zinc-100">startups</span>, taking features from the database all the way to the interface.
      </p>
      <p>
         Outside of work, I spend my free time with my family and playing my beloved{" "}<span class="group/games inline-flex lg:font-medium lg:text-zinc-100"><span class="sr-only">video games</span>{gameLetters.map((letter, i) => (
            <span
               class={`transition duration-75 group-hover/games:-translate-y-px motion-reduce:transition-none ${gameColors[i]}`}
               style={`transition-delay: ${50 + i * 25}ms`}
               aria-hidden="true"
            >{letter === " " ? " " : letter}</span>
         ))}</span>.
      </p>
   </div>
</section>
