---
import '../styles/global.css'
import { langPath, useTranslations, type Lang } from '../i18n/ui'
import AccentGlitch from '../components/AccentGlitch.astro'
import PageReveal from '../components/PageReveal.astro'
import SeoMeta from '../components/SeoMeta.astro'
import ThemeInit from '../components/ThemeInit.astro'

interface Props {
	lang: Lang;
	/** This page's path in each language (defaults to the home pages) */
	paths?: Record<Lang, string>;
	/** Pages that shouldn't be indexed or previewed (the 404) */
	noindex?: boolean;
}

const { lang, paths = langPath, noindex = false } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<ThemeInit />
		<PageReveal />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oxanium:wght@200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
		<title>Keven Gonçalves</title>
		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<SeoMeta lang={lang} title={`Keven Gonçalves — ${t("header.role")}`} description={t("meta.description")} paths={paths} />
		)}
	</head>
	<body>
		<AccentGlitch />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
