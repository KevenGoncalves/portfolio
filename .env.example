# EmailJS keys for the contact form (https://dashboard.emailjs.com)
# Copy this file to .env and fill in your values. .env is git-ignored.
#
# Your EmailJS template can use these variables from the form:
#   {{name}}     sender's name
#   {{email}}    sender's email (set it as the template's "Reply To")
#   {{message}}  the message
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
